#!/usr/bin/env bash
# Control the recipe library, which runs on the Pi. Everything here drives that machine
# over SSH; nothing in this repo runs the app on the laptop any more.
set -euo pipefail

PI="${RECIPE_PI_HOST:-julian_jelfs@pi.local}"
REMOTE="recipe-for-disaster"
HOUSE_URL="https://recipes.julianjelfs.co.uk"
# Reachable from outside the house, and from inside it when DNS is being difficult.
TAILNET_URL="https://pi.tail50bfbf.ts.net:8445"
ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"

on_pi() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$PI" "$@"; }

# The house name only answers on the home wifi. Away from it, fall back to the tailnet.
at_home() { [ -n "$(dig +short A recipes.julianjelfs.co.uk 2>/dev/null)" ]; }

url() {
	if at_home; then echo "$HOUSE_URL"; else echo "$TAILNET_URL"; fi
}

case "${1:-open}" in
	open) open "$(url)" ;;
	url) url ;;
	ssh) exec ssh "$PI" ;;

	status)
		on_pi '
			printf "app       : %s\n" "$(systemctl is-active recipes)"
			printf "caddy     : %s\n" "$(systemctl is-active caddy)"
			if curl -sf -m 3 http://127.0.0.1:8010/api/health >/dev/null; then
				printf "api       : responding on 127.0.0.1:8010\n"
			else
				printf "api       : NOT responding\n"
			fi
			printf "recipes   : %s\n" "$(curl -sf -m 5 http://127.0.0.1:8010/api/recipes | python3 -c "import sys,json; d=json.load(sys.stdin); r=d.get(\"recipes\",d) if isinstance(d,dict) else d; print(len(r))" 2>/dev/null || echo "?")"
			printf "certificate: expires %s\n" "$(echo | openssl s_client -connect 127.0.0.1:443 -servername recipes.julianjelfs.co.uk 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
			n=$(ls -1 ~/recipe-backups/recipes-*.db 2>/dev/null | wc -l | tr -d " ")
			if [ "$n" = 0 ]; then
				printf "backups   : none yet\n"
			else
				printf "backups   : %s, newest %s\n" "$n" "$(ls -1t ~/recipe-backups/recipes-*.db 2>/dev/null | head -1 | xargs -r basename)"
			fi
			printf "next backup: %s\n" "$(systemctl list-timers recipes-backup --no-pager 2>/dev/null | awk "NR==2 {print \$1, \$2, \$3}")"
			printf "disk      : %s used of %s\n" "$(df -h / | awk "NR==2{print \$3}")" "$(df -h / | awk "NR==2{print \$2}")"
			printf "cpu temp  : %.1fC\n" "$(awk "{print \$1/1000}" /sys/class/thermal/thermal_zone0/temp)"
			printf "uptime    : %s\n" "$(uptime -p)"
		'
		if at_home; then
			echo "house     : $HOUSE_URL"
		else
			echo "house     : $HOUSE_URL (not resolving from here)"
		fi
		echo "tailnet   : $TAILNET_URL"
		;;

	logs)   on_pi "sudo journalctl -u recipes -n ${2:-40} -f" ;;
	caddylogs) on_pi "sudo journalctl -u caddy -n ${2:-40} -f" ;;

	start)   on_pi "sudo systemctl start recipes"; echo "started" ;;
	stop)    on_pi "sudo systemctl stop recipes"; echo "stopped" ;;
	restart) on_pi "sudo systemctl restart recipes"; echo "restarted" ;;

	rebuild)
		# The Pi never builds the frontend: Vite and sharp stay on the laptop, which is
		# what lets a 2GB board run this comfortably.
		if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
			echo "warning: uncommitted changes here; the Pi pulls from GitHub and will not see them" >&2
		fi
		echo "==> pulling code on the Pi"
		on_pi "cd $REMOTE && git pull -q && git log --oneline -1"
		echo "==> syncing backend dependencies"
		on_pi "cd $REMOTE/backend && ~/.local/bin/uv sync -q && echo ok"
		echo "==> building the frontend here"
		(cd "$ROOT/frontend" && pnpm install --silent && pnpm run build >/dev/null)
		echo "==> copying the build across"
		rsync -az --delete -e "ssh -o BatchMode=yes" "$ROOT/frontend/build/" "$PI:$REMOTE/frontend/build/"
		echo "==> restarting"
		on_pi "sudo systemctl restart recipes"
		for _ in $(seq 1 40); do
			on_pi "curl -sf -m 1 http://127.0.0.1:8010/api/health" >/dev/null 2>&1 && break
			sleep 0.5
		done
		on_pi "curl -sf -m 3 http://127.0.0.1:8010/api/health" >/dev/null \
			&& echo "done, service healthy. Reload the page." \
			|| { echo "service did not come back; try: recipes logs"; exit 1; }
		;;

	backup)
		echo "==> taking a backup on the Pi"
		on_pi "sudo systemctl start recipes-backup && sudo journalctl -u recipes-backup -n 3 --no-pager | tail -2"
		echo "==> pulling it here"
		bash "$ROOT/deploy/pull-backups.sh"
		;;

	pull) bash "$ROOT/deploy/pull-backups.sh" ;;

	*)
		cat <<'USAGE'
recipes: the family recipe library, running on the Pi

  recipes              open it in a browser
  recipes status       app, Caddy, certificate, backups, disk, temperature
  recipes url          print the URL
  recipes rebuild      after changing code: pull on the Pi, build the UI here, restart
  recipes logs [n]     follow the app log
  recipes caddylogs    follow the Caddy log
  recipes backup       take a backup now and pull it to this laptop
  recipes pull         pull existing backups to this laptop
  recipes ssh          shell onto the Pi
  recipes start|stop|restart
USAGE
		;;
esac
